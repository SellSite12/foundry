{
  "name": "foundry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/phase6-test.mjs",
    "test:all": "node scripts/phase2-test.mjs && node scripts/phase3-test.mjs && node scripts/phase4-test.mjs && node scripts/phase5-test.mjs && node scripts/phase6-test.mjs",
    "test:launch": "node scripts/phase6-test.mjs && node scripts/launch-report.mjs",
    "test:full": "node scripts/run-launch.mjs",
    "setup:env": "node scripts/setup-production-env.mjs",
    "setup:neon": "node scripts/setup-neon.mjs",
    "setup:netlify": "node scripts/setup-netlify.mjs",
    "export:netlify-env": "node scripts/export-netlify-env.mjs",
    "launch:netlify": "node scripts/complete-launch.mjs",
    "deploy:netlify": "node scripts/deploy-netlify-zip.mjs",
    "push:github": "node scripts/github-push.mjs",
    "test:neon": "node scripts/test-neon.mjs",
    "build:netlify": "npx prisma generate && next build",
    "cron": "node scripts/cron-runner.mjs",
    "backup": "node scripts/backup.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@netlify/blobs": "^10.7.9",
    "@netlify/functions": "^5.3.0",
    "@netlify/plugin-nextjs": "^5.15.12",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.2",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "nodemailer": "^9.0.3",
    "prisma": "^6.19.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "26.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1"
  }
