// Foundry — database schema
//
// PostgreSQL (Neon) in all environments. Use the pooled DATABASE_URL for the
// app and DIRECT_URL (non-pooler) for Prisma CLI migrations.
// Allowed values for status/type fields live in src/lib/constants.ts.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// ------------------------------------------------------------------
/// IDENTITY & AUTH
/// ------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  image         String?
  role          String    @default("USER") // USER | ADMIN
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  preferences     UserPreferences?
  sessions        Session[]
  authTokens      AuthToken[]
  stores          Store[]
  orders          Order[]
  subscriptions   Subscription[]
  notifications   Notification[]
  events          AnalyticsEvent[]
  teamMemberships TeamMember[]     @relation("member")
  sentInvites     TeamMember[]     @relation("inviter")
  addresses       Address[]
  paymentMethods  PaymentMethod[]
  wishlist        WishlistItem[]
  carts           Cart[]
  reviews         Review[]
  questions       ProductQuestion[]
  customerLinks   Customer[]
  auditLogs       AuditLog[]
  workspaceMemberships WorkspaceMember[]
  ownedWorkspaces Workspace[]       @relation("workspaceOwner")
  aiDrafts        AiDraft[]
  aiThreads       AiThread[]
  consentRecords  ConsentRecord[]

  @@index([email])
}

model UserPreferences {
  id                 String   @id @default(cuid())
  userId             String   @unique
  theme              String   @default("dark") // dark | light | system
  timezone           String   @default("UTC")
  language           String   @default("en")
  emailNotifications Boolean  @default(true)
  marketingEmails    Boolean  @default(false)
  notificationPrefs  String?  // JSON: per-type channel toggles (Phase 5)
  termsAcceptedAt    DateTime?
  termsVersion       String?
  cookieConsentAt    DateTime?
  analyticsConsent   Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Database-backed sessions. The cookie stores a random token whose
/// SHA-256 hash is persisted here — a leaked DB row cannot be replayed.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use tokens for email verification and password reset.
/// Only the SHA-256 hash of the token is stored.
model AuthToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  type      String // EMAIL_VERIFICATION | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/// ------------------------------------------------------------------
/// STORES & ONBOARDING
/// ------------------------------------------------------------------

model Store {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  slug        String   @unique
  description String?
  logo        String?
  currency    String   @default("USD")
  status      String   @default("ACTIVE") // ACTIVE | PAUSED | ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // business profile (seller onboarding)
  industry      String?
  website       String?
  phone         String?
  businessEmail String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  country       String?
  taxId         String?
  taxRate       Float   @default(0) // percent, e.g. 8.25
  taxInclusive  Boolean @default(false)
  timezone      String  @default("UTC")
  brandColor    String  @default("#E8A33D")

  // onboarding progress (1..5, done when onboardingDone)
  onboardingStep Int     @default(1)
  onboardingDone Boolean @default(false)

  // storefront (Phase 4)
  customDomain String? @unique // custom domain foundation; resolved by proxy in prod

  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products      Product[]
  collections   Collection[]
  orders        Order[]
  customers     Customer[]
  subscriptions Subscription[]
  events        AnalyticsEvent[]
  media         MediaFile[]
  adjustments   InventoryAdjustment[]
  discounts     Discount[]
  giftCards     GiftCard[]
  campaigns     EmailCampaign[]
  automations   AutomationRule[]
  teamMembers   TeamMember[]
  apiKeys       ApiKey[]
  reviews       Review[]
  conversations Conversation[]
  shippingRates ShippingRate[]
  theme         StoreTheme?
  pages         StorePage[]
  carts         Cart[]
  taxRules      TaxRule[]
  questions     ProductQuestion[]
  auditLogs       AuditLog[]
  workspace       Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  workspaceId     String?
  integrations    Integration[]
  webhooks        Webhook[]
  aiInsights      AiInsight[]
  aiDrafts        AiDraft[]
  aiThreads       AiThread[]
  reports         Report[]
  apiRequestLogs  ApiRequestLog[]

  @@index([ownerId])
  @@index([workspaceId])
}

/// ------------------------------------------------------------------
/// STOREFRONT THEME & CONTENT (Phase 4)
/// ------------------------------------------------------------------

/// One row per store: everything the theme customizer edits.
/// JSON columns are stored as strings for SQLite/Postgres portability.
model StoreTheme {
  id      String @id @default(cuid())
  storeId String @unique

  // colors & typography
  primaryColor String @default("#E8A33D")
  accentColor  String @default("#B85C2E")
  mode         String @default("dark") // dark | light
  font         String @default("sans") // sans | serif | mono

  // layout styles
  headerStyle String @default("classic") // classic | centered | minimal
  footerStyle String @default("full") // full | slim
  cardStyle   String @default("rounded") // rounded | square | borderless
  buttonStyle String @default("rounded") // rounded | pill | square

  // announcement bar & hero banner
  announcementText    String?
  announcementEnabled Boolean @default(false)
  bannerUrl           String?
  bannerHeading       String?
  bannerSubheading    String?

  // homepage sections: ordered JSON array of
  // {type: "featured_products"|"featured_collections"|"testimonials"|"faq"|"rich_text", ...config}
  sectionsJson String?

  // structured content rendered on dedicated pages
  testimonialsJson String? // [{author, quote, rating}]
  faqJson          String? // [{question, answer}]

  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

/// Editable storefront content pages (about, contact, privacy, terms).
model StorePage {
  id        String   @id @default(cuid())
  storeId   String
  slug      String // about | contact | privacy | terms
  title     String
  content   String? // plain text / markdown-lite
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
}

/// ------------------------------------------------------------------
/// CATALOG
/// ------------------------------------------------------------------

model Collection {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
}

model Product {
  id          String  @id @default(cuid())
  storeId     String
  name        String
  slug        String
  description String?
  type        String  @default("DIGITAL") // DIGITAL | PHYSICAL | SERVICE | SUBSCRIPTION
  status      String  @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  visibility  String  @default("VISIBLE") // VISIBLE | HIDDEN
  publishAt   DateTime? // scheduled publishing
  archivedAt  DateTime?

  // pricing (integer cents; portable + exact)
  priceCents     Int     @default(0)
  compareAtCents Int?
  costCents      Int?
  currency       String  @default("USD")

  // identification & logistics
  sku               String?
  barcode           String?
  weightGrams       Int?
  lengthCm          Float?
  widthCm           Float?
  heightCm          Float?
  requiresShipping  Boolean @default(false)
  warehouseLocation String?

  // inventory
  trackInventory    Boolean @default(true)
  stock             Int     @default(0)
  reservedStock     Int     @default(0)
  incomingStock     Int     @default(0)
  lowStockThreshold Int     @default(5)

  // organization
  category     String?
  tags         String? // comma-separated
  collectionId String?

  // seo
  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store       Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  collection  Collection?           @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  variants    ProductVariant[]
  orderItems  OrderItem[]
  reviews     Review[]
  adjustments InventoryAdjustment[]
  subscriptions Subscription[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  questions     ProductQuestion[]

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([storeId, name])
  @@index([storeId, sku])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  isVideo   Boolean @default(false)
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// A sellable variation of a product (e.g. Size=M / Color=Red).
/// `options` is a JSON string like {"Size":"M","Color":"Red"}.
model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  name          String // display name, e.g. "M / Red"
  options       String // JSON object of option name -> value
  sku           String?
  barcode       String?
  priceCents    Int? // null = inherit product price
  stock         Int     @default(0)
  reservedStock Int     @default(0)
  incomingStock Int     @default(0)
  position      Int     @default(0)

  product     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  adjustments InventoryAdjustment[]
  cartItems   CartItem[]

  @@index([productId])
}

/// ------------------------------------------------------------------
/// CUSTOMERS (per-store CRM)
/// ------------------------------------------------------------------

model Customer {
  id           String   @id @default(cuid())
  storeId      String
  userId       String? // linked platform account (storefront login), if any
  name         String
  email        String
  phone        String?
  tags         String? // comma-separated
  notes        String?
  taxExempt    Boolean  @default(false)
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders        Order[]
  reviews       Review[]
  conversations Conversation[]

  @@unique([storeId, email])
  @@index([storeId, name])
  @@index([userId])
}

/// ------------------------------------------------------------------
/// ORDERS & PAYMENTS
/// ------------------------------------------------------------------

model Order {
  id          String @id @default(cuid())
  storeId     String
  orderNumber Int // sequential per store

  customerId    String? // registered platform user (buyer), if any
  customerRefId String? // store CRM customer record
  customerEmail String

  status String @default("PENDING") // PENDING | PAID | PROCESSING | PACKED | SHIPPED | DELIVERED | CANCELLED | REFUNDED

  subtotalCents Int    @default(0)
  discountCents Int    @default(0)
  shippingCents Int    @default(0)
  taxCents      Int    @default(0)
  totalCents    Int
  refundedCents Int    @default(0)
  currency      String @default("USD")

  trackingNumber  String?
  shippingCarrier String?
  customerNote    String?
  internalNote    String?

  // checkout snapshot (Phase 4)
  shipName         String?
  shipPhone        String?
  shipLine1        String?
  shipLine2        String?
  shipCity         String?
  shipState        String?
  shipPostalCode   String?
  shipCountry      String?
  shippingMethod   String? // rate name snapshot, e.g. "Standard" / "Local pickup"
  discountCode     String?
  giftCardCode     String?
  giftCardCents    Int     @default(0)

  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer    User?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerRef Customer?   @relation(fields: [customerRefId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  payments    Payment[]
  timeline    OrderEvent[]

  @@unique([storeId, orderNumber])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([customerRefId])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  variantId      String?
  productName    String // snapshot at purchase time
  variantName    String?
  quantity       Int     @default(1)
  unitPriceCents Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

/// Order timeline entries: status changes, notes, refunds, system events.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String // STATUS_CHANGE | NOTE | REFUND | PAYMENT | TRACKING | CREATED
  message   String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String
  provider    String // manual | foundry_pay | stripe | paypal
  providerRef String? // provider-side transaction/intent id
  method      String? // card | wallet | manual
  cardBrand   String? // display only — never raw card data
  cardLast4   String? // display only — never raw card data
  status      String   @default("PENDING") // PENDING | SUCCEEDED | FAILED | REFUNDED
  amountCents Int
  currency    String   @default("USD")
  failureCode String? // e.g. card_declined | insufficient_funds
  riskLevel   String? // low | elevated | high (fraud detection foundation)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Provider-managed saved payment methods. Only display metadata and the
/// provider's token reference are stored — never card numbers or CVCs.
model PaymentMethod {
  id          String   @id @default(cuid())
  userId      String
  provider    String @default("foundry_pay")
  providerRef String // provider token, e.g. fpm_...
  method      String @default("card") // card | wallet
  cardBrand   String?
  cardLast4   String?
  expMonth    Int?
  expYear     Int?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// ------------------------------------------------------------------
/// CART & CHECKOUT (Phase 4)
/// ------------------------------------------------------------------

/// One cart per (visitor, store). Guests are identified by a cookie token;
/// logged-in carts are merged onto the user's account. Old ACTIVE carts
/// double as the abandoned-cart recovery dataset.
model Cart {
  id           String   @id @default(cuid())
  token        String // random visitor id from the cart cookie (one per browser)
  storeId      String
  userId       String?
  status       String   @default("ACTIVE") // ACTIVE | CONVERTED
  discountCode String?
  giftCardCode String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@unique([token, storeId])
  @@index([storeId, status, updatedAt])
  @@index([userId])
}

model CartItem {
  id            String  @id @default(cuid())
  cartId        String
  productId     String
  variantId     String?
  quantity      Int     @default(1)
  savedForLater Boolean @default(false)
  createdAt     DateTime @default(now())

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

/// Customer address book (platform-level, reused across storefronts).
model Address {
  id         String  @id @default(cuid())
  userId     String
  label      String  @default("Home")
  name       String
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

/// Region-based tax rules. The most specific match (country+state, then
/// country, then store default rate) wins at checkout.
model TaxRule {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  country   String // ISO-ish country name or "*" for everywhere
  state     String? // null = whole country
  rate      Float // percent
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, active])
}

/// Product questions & answers on the storefront.
model ProductQuestion {
  id         String    @id @default(cuid())
  storeId    String
  productId  String
  userId     String?
  authorName String
  question   String
  answer     String?
  status     String    @default("PENDING") // PENDING | ANSWERED | HIDDEN
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([storeId, status])
}

/// Security audit trail: checkout, payments, refunds, auth-sensitive actions.
model AuditLog {
  id        String   @id @default(cuid())
  storeId   String?
  userId    String?
  action    String // e.g. checkout.placed | payment.failed | refund.issued
  detail    String? // JSON string
  ipAddress String?
  createdAt DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([action, createdAt])
}

/// ------------------------------------------------------------------
/// INVENTORY
/// ------------------------------------------------------------------

model InventoryAdjustment {
  id         String   @id @default(cuid())
  storeId    String
  productId  String
  variantId  String?
  delta      Int
  reason     String // RESTOCK | CORRECTION | DAMAGE | SALE | RETURN | TRANSFER
  note       String?
  stockAfter Int
  actorName  String?
  createdAt  DateTime @default(now())

  store   Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([productId])
}

/// ------------------------------------------------------------------
/// MEDIA LIBRARY
/// ------------------------------------------------------------------

model MediaFile {
  id        String   @id @default(cuid())
  storeId   String
  folder    String   @default("/")
  name      String // original filename
  mimeType  String
  sizeBytes Int
  url       String // public URL (local /uploads/... in dev; object storage in prod)
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, folder])
  @@index([storeId, name])
}

/// ------------------------------------------------------------------
/// MARKETING
/// ------------------------------------------------------------------

model Discount {
  id               String    @id @default(cuid())
  storeId          String
  kind             String    @default("CODE") // CODE | AUTOMATIC | BUNDLE
  code             String? // required for kind=CODE
  title            String
  type             String    @default("PERCENT") // PERCENT | FIXED_AMOUNT | FREE_SHIPPING
  value            Int       @default(0) // percent (0-100) or cents
  minSubtotalCents Int?
  usageLimit       Int?
  usedCount        Int       @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  status           String    @default("ACTIVE") // ACTIVE | DISABLED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@index([storeId, status])
}

model GiftCard {
  id           String    @id @default(cuid())
  storeId      String
  code         String
  initialCents Int
  balanceCents Int
  note         String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
}

model EmailCampaign {
  id             String    @id @default(cuid())
  storeId        String
  name           String
  subject        String
  preheader      String?
  body           String?
  status         String    @default("DRAFT") // DRAFT | SCHEDULED | SENT
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

/// Automation rules — the foundation for abandoned cart, referral,
/// affiliate, and operational automations. Phase 4 wires the triggers
/// that need a storefront.
model AutomationRule {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  trigger   String // ORDER_CREATED | STOCK_LOW | CUSTOMER_CREATED | CART_ABANDONED | REFERRAL_SIGNUP | AFFILIATE_SALE
  action    String // NOTIFY | SEND_EMAIL | TAG_CUSTOMER
  config    String? // JSON string
  enabled   Boolean  @default(true)
  runCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

/// ------------------------------------------------------------------
/// TEAM & ACCESS
/// ------------------------------------------------------------------

model TeamMember {
  id          String    @id @default(cuid())
  storeId     String
  email       String
  userId      String?
  role        String    @default("SUPPORT") // OWNER | ADMIN | MANAGER | SUPPORT | WAREHOUSE
  permissions String? // JSON string of custom permission overrides
  status      String    @default("INVITED") // INVITED | ACTIVE | REMOVED
  invitedById String?
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User? @relation("member", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("inviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([storeId, email])
  @@index([userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  storeId    String
  name       String
  prefix     String // first 8 chars, shown in UI
  keyHash    String    @unique
  scopes     String    @default("read") // read | read_write
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  requestLogs ApiRequestLog[]

  @@index([storeId])
}

/// ------------------------------------------------------------------
/// REVIEWS & INBOX
/// ------------------------------------------------------------------

model Review {
  id         String   @id @default(cuid())
  storeId    String
  productId  String
  customerId String?
  userId     String? // platform account of the reviewer (edit/delete rights)
  authorName String
  rating     Int // 1..5
  title      String?
  body       String?
  photosJson String? // JSON array of uploaded photo URLs
  verified   Boolean  @default(false) // reviewer purchased this product
  reply      String?
  status     String   @default("PENDING") // PENDING | PUBLISHED | HIDDEN
  reportedAt DateTime? // seller flagged this review as abusive
  reportNote String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([storeId, status])
  @@index([productId])
  @@index([userId])
}

model Conversation {
  id         String   @id @default(cuid())
  storeId    String
  customerId String?
  subject    String
  status     String   @default("OPEN") // OPEN | CLOSED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([storeId, status])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  from           String // CUSTOMER | STORE
  authorName     String?
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// ------------------------------------------------------------------
/// SHIPPING
/// ------------------------------------------------------------------

model ShippingRate {
  id             String  @id @default(cuid())
  storeId        String
  name           String // e.g. "Standard", "Express"
  kind           String  @default("DELIVERY") // DELIVERY | PICKUP
  region         String  @default("Everywhere")
  countries      String? // comma-separated country list; null/empty = everywhere
  priceCents     Int     @default(0)
  freeAboveCents Int? // free shipping over this subtotal
  minDays        Int?
  maxDays        Int?
  active         Boolean @default(true)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

/// ------------------------------------------------------------------
/// SUBSCRIPTIONS (platform billing)
/// ------------------------------------------------------------------

model Subscription {
  id                 String    @id @default(cuid())
  userId             String
  storeId            String?
  productId          String?
  plan               String    @default("STARTER") // STARTER | GROWTH | SCALE
  status             String    @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELED | TRIALING
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([storeId])
}

/// ------------------------------------------------------------------
/// PLATFORM
/// ------------------------------------------------------------------

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  storeId   String?
  type      String // e.g. user.signup, order.created, storefront.visit
  payload   String? // JSON string (portable across SQLite/Postgres)
  createdAt DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([type, createdAt])
  @@index([userId])
  @@index([storeId, type, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    @default("INFO") // INFO | SUCCESS | WARNING | SECURITY | ORDER | INVENTORY | PAYMENT | CUSTOMER | TEAM
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/// ------------------------------------------------------------------
/// PHASE 5 — AI, AUTOMATION, INTEGRATIONS & ENTERPRISE
/// ------------------------------------------------------------------

/// Organization grouping multiple stores (enterprise workspaces).
model Workspace {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  slug      String   @unique
  plan      String   @default("STARTER") // STARTER | GROWTH | SCALE | ENTERPRISE
  status    String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User              @relation("workspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  stores  Store[]
  members WorkspaceMember[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("MEMBER") // OWNER | ADMIN | MANAGER | MEMBER
  permissions String?  // JSON overrides
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// Third-party service connections (payments, shipping, CRM, etc.).
model Integration {
  id           String    @id @default(cuid())
  storeId      String
  provider     String    // stripe | shippo | mailchimp | zapier | ...
  category     String    // PAYMENT | SHIPPING | MARKETING | CRM | EMAIL | SMS | ANALYTICS | STORAGE | SUPPORT
  status       String    @default("DISCONNECTED") // CONNECTED | DISCONNECTED | ERROR
  credentials  String?   // encrypted JSON blob
  config       String?   // non-secret JSON settings
  lastSyncAt   DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
  @@index([storeId, category])
}

/// Outbound webhook subscriptions for store events.
model Webhook {
  id           String   @id @default(cuid())
  storeId      String
  url          String
  events       String   // comma-separated event names
  secret       String   // HMAC signing secret
  active       Boolean  @default(true)
  failureCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([storeId, active])
}

/// Individual webhook delivery attempts with retry tracking.
model WebhookDelivery {
  id           String    @id @default(cuid())
  webhookId    String
  event        String
  payload      String    // JSON
  status       String    @default("PENDING") // PENDING | SUCCEEDED | FAILED
  responseCode Int?
  responseBody String?
  attempts     Int       @default(0)
  nextRetryAt  DateTime?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, status])
  @@index([status, nextRetryAt])
}

/// Durable background job queue (processed by cron worker).
model BackgroundJob {
  id          String    @id @default(cuid())
  storeId     String?
  type        String    // email.send | report.generate | webhook.deliver | automation.run | import.process
  status      String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  payload     String    // JSON
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
  @@index([storeId, type])
}

/// AI-generated business insights computed from live store data.
model AiInsight {
  id          String   @id @default(cuid())
  storeId     String
  kind        String   // revenue_trend | slow_mover | restock | retention | marketing | cart_risk | ...
  title       String
  body        String
  explanation String   // why this recommendation was made
  dataJson    String?  // supporting metrics JSON
  priority    String   @default("NORMAL") // LOW | NORMAL | HIGH
  status      String   @default("NEW") // NEW | DISMISSED | ACTED
  createdAt   DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status, createdAt])
}

/// AI-generated content awaiting user review before publishing.
model AiDraft {
  id         String   @id @default(cuid())
  storeId    String
  userId     String
  kind       String   // product_description | seo_title | seo_description | email | social | support_reply
  targetType String?  // product | customer | campaign | review
  targetId   String?
  prompt     String?
  content    String
  status     String   @default("PENDING") // PENDING | PUBLISHED | DISCARDED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([userId])
}

/// AI assistant conversation threads.
model AiThread {
  id        String   @id @default(cuid())
  storeId   String
  userId    String
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([storeId, userId])
}

model AiMessage {
  id        String   @id @default(cuid())
  threadId  String
  role      String   // user | assistant
  content   String
  dataJson  String?  // cited metrics used in the response
  createdAt DateTime @default(now())

  thread AiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// Scheduled / on-demand business reports.
model Report {
  id          String    @id @default(cuid())
  storeId     String
  name        String
  type        String    // sales | inventory | customers | marketing | financial
  format      String    @default("CSV") // CSV | JSON
  schedule    String?   // DAILY | WEEKLY | MONTHLY | QUARTERLY | YEARLY | null = on-demand
  recipients  String?   // comma-separated emails
  config      String?   // JSON filters
  lastRunAt   DateTime?
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  runs  ReportRun[]

  @@index([storeId])
}

model ReportRun {
  id        String    @id @default(cuid())
  reportId  String
  status    String    @default("PENDING") // PENDING | COMPLETED | FAILED
  fileUrl   String?
  rowCount  Int?
  error     String?
  createdAt DateTime  @default(now())
  completedAt DateTime?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
}

/// Public API request log for developer portal.
model ApiRequestLog {
  id         String   @id @default(cuid())
  storeId    String
  apiKeyId   String?
  method     String
  path       String
  statusCode Int
  durationMs Int
  createdAt  DateTime @default(now())

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([apiKeyId])
}

/// ------------------------------------------------------------------
/// PHASE 6 — PRODUCTION OBSERVABILITY & COMPLIANCE
/// ------------------------------------------------------------------

/// Centralized structured application logs (searchable, retention-managed).
model SystemLog {
  id        String   @id @default(cuid())
  level     String   // info | warn | error
  category  String   // auth | order | payment | api | webhook | automation | system
  message   String
  detail    String?  // JSON
  userId    String?
  storeId   String?
  requestId String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([category, createdAt])
  @@index([level, createdAt])
  @@index([requestId])
}

/// Consent audit trail for cookies, analytics, and terms acceptance.
model ConsentRecord {
  id        String   @id @default(cuid())
  userId    String?
  type      String   // cookies | analytics | terms | marketing
  granted   Boolean
  version   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, type, createdAt])
  @@index([type, createdAt])
}
