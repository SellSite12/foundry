# ------------------------------------------------------------------
# Foundry environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ------------------------------------------------------------------

# Database — Neon Postgres (required)
# Pooled URL for the app (hostname contains -pooler):
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct URL for Prisma CLI migrations (no -pooler):
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Absolute base URL of the app (used in emails, SEO, redirects).
APP_URL="http://localhost:3000"

# Application version (shown in health checks and reports).
APP_VERSION="0.2.0"

# SMTP settings for transactional email (verification, password reset, orders).
# Option A (recommended for Netlify): Resend — https://resend.com
RESEND_API_KEY=""
# Option B: SMTP provider
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Foundry <onboarding@resend.dev>"
# Inbox for platform support ticket notifications (defaults to EMAIL_FROM)
SUPPORT_EMAIL="support@yourdomain.com"

# Uploads: "local" for dev disk, "blobs" for Netlify (auto-set in netlify.toml)
UPLOAD_STORE="local"

# Production secrets (REQUIRED in production — no dev fallbacks)
INTERNAL_SECRET=""
CRON_SECRET=""
INTEGRATION_ENCRYPTION_KEY=""
METRICS_SECRET=""

# Optional: distributed rate limiting (recommended for multi-instance deploys)
REDIS_URL=""

# Payments (optional — Foundry Pay used when unset)
STRIPE_SECRET_KEY=""

# AI (optional — data-driven insights work without this)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Node environment
NODE_ENV="development"
